{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bitwarden-mxroute-generator",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "workers_dev": false,
  "services": [
    {
      "binding": "CORE",
      "service": "bitwarden-mxroute-core",
      "entrypoint": "GeneratorEntrypoint"
    }
  ],
  "ratelimits": [
    {
      "name": "PREAUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "TOKEN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
